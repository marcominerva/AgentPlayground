<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);BL0016;SKEXP0010;SKEXP0050;OPENAI001;MAAI001;MEAI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Markdig" Version="1.6.0" />
        <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.28.0-preview.261106.1" />
        <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
        <PackageReference Include="TinyHelpers.AspNetCore" Version="4.2.19" />
    </ItemGroup>

</Project>
