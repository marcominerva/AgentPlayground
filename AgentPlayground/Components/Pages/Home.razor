@page "/"

@using System.Net
@using Microsoft.Extensions.AI

@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime

<PageTitle>Agent Playground</PageTitle>

<div class="card chat-card mx-auto my-4">
    <div class="card-body">

        @if (messages.Count == 0)
        {
            <div class="h-100 d-flex flex-column justify-content-center align-items-center text-body-secondary">
                <i class="bi bi-chat-square-quote-fill text-primary" style="font-size: 4rem;"></i>
                <p class="mt-3 mb-1 fw-semibold">Chat with your agent</p>
                <p class="small mb-0">Ask me anything. Press the up arrow key to recall your previous question.</p>
            </div>
        }

        @foreach (var message in messages)
        {
            if (message.Role == "user")
            {
                <div class="d-flex align-items-baseline text-end justify-content-end">
                    <div class="pe-2">
                        <div>
                            <div class="card card-text d-inline-block p-2 px-3 m-1">
                                <Markdown Content="@message.Text" style="overflow-y:auto;" />
                            </div>
                        </div>
                    </div>
                    <div class="avatar avatar-user">
                        <i class="bi bi-person-fill" aria-hidden="true"></i>
                    </div>
                </div>
            }
            else if (message.Role == "assistant")
            {
                <div class="d-flex align-items-baseline">
                    <div class="avatar avatar-assistant">
                        <i class="bi bi-robot" aria-hidden="true"></i>
                    </div>
                    <div class="pe-2">
                        <div>
                            @if (message.IsEmpty)
                            {
                                <div class="card card-text d-inline-block p-3 px-3 m-1">
                                    <div class="typing-indicator" role="status" aria-label="The assistant is typing">
                                        <span class="typing-dot"></span>
                                        <span class="typing-dot"></span>
                                        <span class="typing-dot"></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card card-text d-inline-block p-2 px-3 m-1">
                                    @if (!string.IsNullOrWhiteSpace(message.ReasoningText))
                                    {
                                        <div class="small fst-italic text-body-secondary mb-2">
                                            <Markdown Content="@message.ReasoningText" style="overflow-y:auto;" />
                                        </div>
                                    }
                                    <div class="message-content">
                                        <div class="streaming-content">
                                            <div class="streaming-text @(message.Status == MessageStatus.Streaming ? "streaming-text-with-spinner" : "")">
                                                @if (!string.IsNullOrWhiteSpace(message.Text))
                                                {
                                                    <Markdown Content="@message.Text" style="overflow-y:auto;" />
                                                }
                                                @if (!string.IsNullOrEmpty(message.ImageBase64Data))
                                                {
                                                    <img src="@message.ImageBase64Data" class="generated-image" alt="Generated image" />
                                                }
                                            </div>
                                            @if (message.Status == MessageStatus.Streaming)
                                            {
                                                <div class="streaming-spinner-bottom-left">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                        <span class="visually-hidden">Loading...</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (message.Status == MessageStatus.Completed)
                                    {
                                        <div class="assistant-actions d-flex justify-content-between align-items-center mt-3">
                                            <div class="text-start bg-transparent d-flex align-items-center gap-3">
                                                @if (message.TokenUsage is not null)
                                                {
                                                    <span class="d-flex align-items-center" data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="bottom" data-bs-custom-class="tooltip-primary" data-bs-title="@message.TokenUsage">
                                                        <i class="bi bi-cash-coin"></i>
                                                    </span>
                                                }
                                                @if (message.FunctionCalls.Count > 0)
                                                {
                                                    <span class="d-flex align-items-center" data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="bottom" data-bs-custom-class="tooltip-primary" data-bs-title="@message.FunctionCallsTooltip">
                                                        <i class="bi bi-terminal"></i>
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-end bg-transparent copy-button">
                                                <span data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="@(copiedMessage == message ? "Copied!" : "Copy to clipboard")">
                                                    <button type="button" class="btn" @onclick="@(async () => await CopyToClipboardAsync(message))">
                                                        @if (copiedMessage == message)
                                                        {
                                                            <i class="bi bi-check text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-clipboard"></i>
                                                        }
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <div @ref="chat"></div>
    </div>

    <div class="card-footer bg-body w-100 bottom-0 m-0 p-1">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-0">
                <span class="d-flex" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Messages aren't stored in any way, either on the client or on the server.">
                    <i class="bi bi-shield-lock-fill text-success"></i>
                </span>
            </span>
            <input @ref="askInput" type="text" @bind="@question" @bind:event="oninput" placeholder="Ask me anything..." class="form-control border-0" maxlength="2000" @onkeydown="HandleKeyDown" />
            <div class="input-group-text bg-transparent border-0">
                @if (isAsking)
                {
                    <button type="button" class="btn btn-danger" @onclick="StopResponse" aria-label="Stop response">
                        <i class="bi bi-stop-fill"></i>
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(question)" @onclick="AskQuestion" aria-label="Send message">
                        <i class="bi bi-send"></i>
                    </button>
                }
                <span data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Start a new conversation">
                    <button type="reset" class="btn btn-secondary ms-2" disabled="@isAsking" @onclick="Reset">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </span>
            </div>
        </div>
    </div>
</div>

@code
{
    private ElementReference askInput = default!;
    private ElementReference chat = default!;

    private IList<Message> messages = [];
    private string? question;

    private Guid conversationId = Guid.NewGuid();
    private bool isAsking;
    private CancellationTokenSource? askCancellationTokenSource;

    private Message? copiedMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bootstrap tooltips are opt-in, so they must be (re)initialized whenever the rendered markup changes.
        await JSRuntime.InvokeVoidAsync("initTooltips");

        // Scrolling here guarantees the browser DOM already contains the latest messages.
        if (messages.Count > 0)
        {
            await EnsureMessageIsVisibleAsync();
        }

        if (!firstRender)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("setFocus", askInput);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (isAsking)
        {
            return;
        }

        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(question))
        {
            await AskQuestion();
        }
        else if (e.Key == "ArrowUp" && messages.Count >= 2)
        {
            question = messages[^2].Text;
        }
    }

    private async Task AskQuestion()
    {
        if (isAsking || string.IsNullOrWhiteSpace(question))
        {
            return;
        }

        isAsking = true;
        askCancellationTokenSource = new();

        var cancellationToken = askCancellationTokenSource.Token;

        var userQuestion = new Question(conversationId, question);
        var userMessage = new Message { Text = userQuestion.Text, Role = "user", Status = MessageStatus.Completed };
        messages.Add(userMessage);

        var assistantMessage = new Message { Role = "assistant", Status = MessageStatus.New };
        messages.Add(assistantMessage);

        question = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            await using var scope = ServiceScopeFactory.CreateAsyncScope();
            var agentService = scope.ServiceProvider.GetRequiredService<AgentService>();

            var response = agentService.AskStreamingAsync(userQuestion, cancellationToken);

            await foreach (var update in response.WithCancellation(cancellationToken))
            {
                if (update.StreamState == StreamState.Reasoning)
                {
                    assistantMessage.Status = MessageStatus.Streaming;
                    assistantMessage.ReasoningText += update.Text;
                }
                else if (update.StreamState == StreamState.Answering)
                {
                    // Adds tokens to the assistant message as they are received.
                    assistantMessage.Status = MessageStatus.Streaming;
                    assistantMessage.Text += update.Text;
                }
                else if (update.StreamState == StreamState.FunctionCalling && !string.IsNullOrEmpty(update.Text))
                {
                    assistantMessage.Status = MessageStatus.Streaming;
                    assistantMessage.FunctionCalls.Add(update.Text);
                }
                else if (update.StreamState == StreamState.ImageGeneration)
                {
                    assistantMessage.Status = MessageStatus.Streaming;
                    assistantMessage.ImageBase64Data = update.Text;
                }
                else if (update.StreamState == StreamState.Completed)
                {
                    assistantMessage.Status = MessageStatus.Completed;
                    assistantMessage.TokenUsage = FormatTokenUsage(update.TokenUsage);
                    assistantMessage.FunctionCallsTooltip = FormatFunctionCalls(assistantMessage.FunctionCalls);
                }

                await InvokeAsync(StateHasChanged);
                await EnsureMessageIsVisibleAsync();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            if (assistantMessage.IsEmpty)
            {
                assistantMessage.Text = "Response cancelled.";
            }

            assistantMessage.Status = MessageStatus.Completed;
        }
        catch (Exception ex)
        {
            assistantMessage.Text = $"There was an error while processing your question: {ex.Message}";
            assistantMessage.Status = MessageStatus.Completed;
        }
        finally
        {
            askCancellationTokenSource?.Dispose();
            askCancellationTokenSource = null;

            isAsking = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopResponse()
    {
        askCancellationTokenSource?.Cancel();
    }

    private void Reset()
    {
        question = null;
        conversationId = Guid.NewGuid();
        copiedMessage = null;
        messages.Clear();
    }

    private async Task CopyToClipboardAsync(Message message)
    {
        if (string.IsNullOrEmpty(message.Text))
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", message.Text);

        copiedMessage = message;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(3000); // Shows the checkmark for 3 seconds

        if (copiedMessage == message)
        {
            copiedMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatTokenUsage(UsageDetails? tokenUsage)
    {
        if (tokenUsage is null)
        {
            return string.Empty;
        }

        // Reasoning tokens are part of the output tokens, so they're shown as an indented detail of that value.
        var outputTokens = tokenUsage.ReasoningTokenCount is > 0
            ? $"Output tokens: {tokenUsage.OutputTokenCount}<br /><span class=\"ms-3 small\">&bull; Reasoning: {tokenUsage.ReasoningTokenCount}</span>"
            : $"Output tokens: {tokenUsage.OutputTokenCount}";

        var details = string.Join("<br />",
        [
            $"Input tokens: {tokenUsage.InputTokenCount}",
            outputTokens,
            $"Total tokens: {tokenUsage.TotalTokenCount}"
        ]);

        return details;
    }

    private static string FormatFunctionCalls(IEnumerable<string> functionCalls)
    {
        return string.Join("<br />", ["Function calls:", .. functionCalls.Select(WebUtility.HtmlEncode)]);
    }

    private async Task EnsureMessageIsVisibleAsync()
    {
        await JSRuntime.InvokeVoidAsync("scrollTo", chat);
    }
    public enum MessageStatus
    {
        New,
        Streaming,
        Completed
    }

    public class Message
    {
        public List<string> FunctionCalls { get; set; } = [];

        public string? FunctionCallsTooltip { get; set; }

        public string? ReasoningText { get; set; }

        public string? ImageBase64Data { get; set; }

        public string? Text { get; set; }

        public bool IsEmpty => Text is null && ReasoningText is null && ImageBase64Data is null;

        public required string Role { get; set; }

        public MessageStatus Status { get; set; } = MessageStatus.New;

        public string? TokenUsage { get; set; }
    }
}
